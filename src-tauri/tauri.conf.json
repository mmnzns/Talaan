{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talaan",
  "version": "1.2.0",
  "identifier": "com.craftconceptsdigital.talaan",
  "build": {
    "beforeDevCommand": "sh scripts/build-llm-helper.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "sh scripts/build-llm-helper.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talaan",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/Talaan/meetings/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/talaan-llm"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMjRBNjVBQzRCN0I1OTcKUldTWHRiZkVXcVlrYnNGRGhTSjlpMXlzYkZZaFlUWVNEYVFtZzhscEJiVnNJclh0OUlIRDRQdGQK",
      "endpoints": [
        "https://github.com/mmnzns/Talaan/releases/latest/download/latest.json"
      ]
    }
  }
}
